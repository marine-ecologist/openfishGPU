# Generate independent, random values; never commit .env.
PUBLIC_ORIGIN=http://localhost:8000
APP_PASSWORD=
SESSION_SECRET=
DATABASE_PATH=data/jobs.sqlite3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Dedicated output root. Never reuse OpenReef's jobs folder.
GOOGLE_DRIVE_JOB_ROOT_ID=
GOOGLE_DRIVE_SOURCE_ROOT_ID=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_EXECUTION_TIMEOUT_MS=7200000
MAX_VIDEO_BYTES=21474836480
# Worker only: mount model files on the endpoint's network volume.
OPENFISH_DETECTOR_MODEL=/runpod-volume/openfish/models/cfd-complete.pt
DETECTOR_SHA256=
OPENFISHID_SPECIES_MODEL=/runpod-volume/openfish/models/species
GPU_BATCH=4
